{
  "name": "sayaqr",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Privacy-first offline QR code generator built with Vite and TypeScript.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:fixtures": "node scripts/export-fixtures.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "pdf-lib": "^1.17.1"
  }
}
